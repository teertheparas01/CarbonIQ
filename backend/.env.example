# Backend environment variables
# Copy this file to .env and modify as needed

# CORS: Comma-separated list of allowed origins for CORS
# Defaults to localhost:5173 and localhost:4173
# For production, add your Vercel deployment URL(s)
# ALLOWED_ORIGINS=http://localhost:5173,https://carboniq-hazel.vercel.app

# Vercel deployment origin (auto-detected if deployed on Vercel)
# VERCEL_ORIGIN=https://your-app.vercel.app

# Model path (relative to backend/ directory)
# MODEL_PATH=carboniq_seasonal_gb.joblib

# Metadata path
# METADATA_PATH=carboniq_model_metadata.json